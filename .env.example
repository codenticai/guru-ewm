# Guru-EWM Environment Configuration
# Copy to .env and adjust as needed:  cp .env.example .env

# ── Network ─────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=guru-ewm
EWM_NETWORK=ewm-net

# ── Service URLs (internal Docker network) ──────────────────────────
HLLSET_CORTEX_URL=http://hllset-cortex:9092
HLLSET_NEXT_URL=http://hllset-next:9090
DEEPSEEK_OCR_URL=http://deepseek-ocr:9093
MEDICAL_DIAGNOSTIC_URL=http://medical-diagnostic:9094
INVOICE_EXTRACTOR_URL=http://invoice-extractor:9096
IPFS_API_URL=http://ipfs:5001
GATEWAY_URL=http://ewm-gateway:8001

# ── Ports (host mapping) ────────────────────────────────────────────
HLLSET_NEXT_PORT=9090
HLLSET_CORTEX_PORT=9092
DEEPSEEK_OCR_PORT=9093
MEDICAL_DIAGNOSTIC_PORT=9094
NLP_MODEL_PORT=9095
INVOICE_EXTRACTOR_PORT=9096
GATEWAY_PORT=8001
UI_PORT=8080
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8081

# ── IPFS ────────────────────────────────────────────────────────────
IPFS_PROFILE=server

# ── DeepSeek-OCR model (GPU only) ─────────────────────────────────
# The service OCRs with Tesseract on CPU by default. To run the real
# DeepSeek-OCR model: set this to true AND uncomment the torch/
# transformers deps in deepseek-ocr/requirements.txt, switch the
# Dockerfile base to a CUDA image, and enable the nvidia GPU
# reservation in docker-compose.yml.
#   auto  = use the model iff a CUDA GPU is available (default)
#   true  = force the model path on
#   false = Tesseract CPU only
DEEPSEEK_OCR_GPU_ENABLED=auto
# HF repo id or local path to the model weights
DEEPSEEK_OCR_MODEL_PATH=deepseek-ai/DeepSeek-OCR
# Inference engine: transformers (default) or vllm
DEEPSEEK_OCR_ENGINE=transformers
CUDA_VISIBLE_DEVICES=0

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── hllset-next lattice storage ─────────────────────────────────────
# memory = in-memory (dev) | ipfrs = persistent sled-backed (default)
HLLSET_STORAGE=ipfrs

# ── Optional HLLSet services (NOT required to run the app) ──────────
# Only used with: docker compose -f docker-compose.yml -f docker-compose.optional.yml
# Copy the projects into ./hllset-next and ./hllset-cortex, OR override
# these with absolute paths to your local copies.
# HLLSET_NEXT_CONTEXT=./hllset-next
# HLLSET_CORTEX_CONTEXT=./hllset-cortex

# ── UI resource badge (optional Docker socket mount) ────────────────
# Enable to show CPU/RAM usage in the header. Leaving this unset disables
# the socket mount (safe default).
# Linux:   DOCKER_SOCK_MOUNT=/var/run/docker.sock
# Windows: DOCKER_SOCK_MOUNT=//var/run/docker.sock
